@startuml
title Diagrama Entitate-Relație - Campus Sports Booking
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam linetype ortho
!pragma layout smetana
hide circle
skinparam class {
  BackgroundColor #F9C98B
  BorderColor #333333
  HeaderBackgroundColor #F2A65A
}

entity users {
  * **id** : serial <<PK>>
  --
  email : varchar <<UQ>>
  password_hash : varchar
  full_name : varchar
  role : user_role (student/teacher/admin)
  status : account_status
  blocked_until : timestamptz
  created_at : timestamptz
}

entity sports {
  * **id** : serial <<PK>>
  --
  name : varchar <<UQ>>
}

entity facilities {
  * **id** : serial <<PK>>
  --
  # sport_id : int <<FK>>
  name : varchar
  location : varchar
  description : varchar
  capacity : int
  price_per_hour : numeric
  opens_at : time
  closes_at : time
  status : facility_status (active/maintenance/inactive)
}

entity facility_images {
  * **id** : serial <<PK>>
  --
  # facility_id : int <<FK>>
  path : varchar
  position : int
  created_at : timestamptz
}

entity time_slots {
  * **id** : serial <<PK>>
  --
  # facility_id : int <<FK>>
  starts_at : timestamptz
  ends_at : timestamptz
  auction_closes_at : timestamptz
}

entity teams {
  * **id** : serial <<PK>>
  --
  # sport_id : int <<FK>>
  # captain_id : int <<FK>>
  name : varchar
  max_players : int
  join_mode : team_join_mode
  created_at : timestamptz
}

entity team_members {
  * # team_id : int <<PK,FK>>
  * # user_id : int <<PK,FK>>
  --
  joined_at : timestamptz
}

entity team_invitations {
  * **id** : serial <<PK>>
  --
  # team_id : int <<FK>>
  # invited_user_id : int <<FK>>
  status : invitation_status
  created_at : timestamptz
  responded_at : timestamptz
}

entity bookings {
  * **id** : serial <<PK>>
  --
  # slot_id : int <<FK>>
  # team_id : int <<FK>>
  # captain_id : int <<FK>>
  status : booking_status
  total_places : int
  is_open_match : boolean
  qr_code : varchar <<UQ>>
  created_at : timestamptz
  confirmed_at : timestamptz
  cancelled_at : timestamptz
  # cancelled_by : int <<FK>>
  cancel_reason : varchar
  # displaced_by : int <<FK>>
  checked_in_at : timestamptz
}

entity payments {
  * **id** : serial <<PK>>
  --
  # user_id : int <<FK>>
  # booking_id : int <<FK>>
  # sanction_id : int <<FK>>
  amount : numeric
  method : varchar
  status : payment_status
  provider_ref : varchar
  created_at : timestamptz
  refunded_at : timestamptz
}

entity bids {
  * **id** : serial <<PK>>
  --
  # slot_id : int <<FK>>
  # team_id : int <<FK>>
  # captain_id : int <<FK>>
  amount : numeric
  status : bid_status
  created_at : timestamptz
}

entity incidents {
  * **id** : serial <<PK>>
  --
  # user_id : int <<FK>>
  # booking_id : int <<FK>>
  type : incident_type
  description : varchar
  recorded_at : timestamptz
}

entity sanctions {
  * **id** : serial <<PK>>
  --
  # user_id : int <<FK>>
  # lifted_by : int <<FK>>
  reason : varchar
  starts_at : timestamptz
  ends_at : timestamptz
  fine_amount : numeric
  lifted_at : timestamptz
  lift_method : lift_method
}

entity notifications {
  * **id** : serial <<PK>>
  --
  # user_id : int <<FK>>
  # booking_id : int <<FK>>
  type : varchar
  subject : varchar
  sent_at : timestamptz
}

entity booking_participants {
  * # booking_id : int <<PK,FK>>
  * # user_id : int <<PK,FK>>
  --
  status : participant_status
  invited_at : timestamptz
  joined_at : timestamptz
}

entity waiting_list {
  * # slot_id : int <<PK,FK>>
  * # user_id : int <<PK,FK>>
  --
  created_at : timestamptz
}

entity facility_closures {
  * **id** : serial <<PK>>
  --
  # facility_id : int <<FK>>
  starts_at : timestamptz
  ends_at : timestamptz
  reason : varchar
}

entity booking_rules {
  * **id** : smallint <<PK>>
  --
  monthly_booking_limit : int
  limit_applies_to_teachers : boolean
  free_cancel_hours : int
  checkin_minutes_before : int
  sanction_after_incidents : int
  ban_months : int
  unban_fine_amount : numeric
}

sports ||--o{ facilities
sports ||--o{ teams
facilities ||--o{ time_slots
facilities ||--o{ facility_images
users ||--o{ teams : căpitan
teams ||--o{ team_members
users ||--o{ team_members
teams ||--o{ team_invitations
users ||--o{ team_invitations : invitat
time_slots ||--o{ bookings
teams |o--o{ bookings
users ||--o{ bookings : căpitan
bookings |o--o{ payments
time_slots ||--o{ bids
teams ||--o{ bids
users ||--o{ bids : căpitan
bookings |o--o{ incidents
users ||--o{ incidents
bookings ||--o{ booking_participants
users ||--o{ booking_participants
time_slots ||--o{ waiting_list
users ||--o{ waiting_list
facilities ||--o{ facility_closures
users |o--o{ bookings : anulat de
bookings |o--o| bookings : preluat de
sanctions |o--o{ payments
users ||--o{ payments : plătitor
users ||--o{ sanctions
users |o--o{ sanctions : deblocat de
users ||--o{ notifications
bookings |o--o{ notifications
@enduml
